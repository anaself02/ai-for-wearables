{
  "feature_set": "full",
  "window_seconds": 60,
  "step_seconds": 30,
  "label_purity_threshold": 1.0,
  "target_labels": {
    "1": "baseline",
    "2": "stress",
    "3": "amusement"
  },
  "sampling_rates_hz": {
    "wrist_ACC": 32,
    "wrist_BVP": 64,
    "wrist_EDA": 4,
