# --- Django ---
DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=True

# Timezone used for all day-window maths. Must match the timezone your device
# stamps its Google Health civil times in (observed offset: -14400s = UTC-4).
DJANGO_TIME_ZONE=America/New_York

# --- Fernet key used to encrypt OAuth tokens at rest ---
# Generate a new one with:
#   .venv/Scripts/python.exe -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: changing this key makes all stored tokens unreadable (users must reconnect).
FERNET_KEY=replace-me

# --- Google OAuth 2.0 client (Cloud Console > Credentials > OAuth client, type "Web application") ---
GOOGLE_OAUTH_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=replace-me

# Must match EXACTLY an "Authorized redirect URI" registered on that OAuth client.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/oauth/callback/

# Force IPv4 for outbound API calls.
# This host advertises IPv6 but has no working IPv6 route: health.googleapis.com
# returns 8 AAAA records before its A records, and urllib3 tries them strictly in
# order, costing ~21s each (~169s per request) before falling back to IPv4.
# Set to False if this app ever runs on a host with working IPv6.
FORCE_IPV4=True
