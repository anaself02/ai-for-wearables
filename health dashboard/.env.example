# The only value the app needs to start. Everything else has a default.
DJANGO_SECRET_KEY=replace-me

# True for local development.
DJANGO_DEBUG=True

# Timezone Django uses for dates it formats itself. People's local days are cut
# in each Person's own timezone (default America/Toronto), not in this one.
DJANGO_TIME_ZONE=America/Toronto

# Where the wearable-ml project (the WESAD-trained model) lives. Defaults to the
# sibling folder "../wearable-ml". Four files are read from its models/ folder
# and nothing is ever written there.
# WEARABLE_ML_DIR=../wearable-ml

# There is no Google sign-in, no OAuth client and no token encryption: the app
# reads files that were uploaded to it, runs only on localhost, and stores
# nothing that could reach an account.
